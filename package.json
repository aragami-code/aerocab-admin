{
  "name": "@aerogo24/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AeroGo 24 Connect - Dashboard Admin (React + Tailwind CSS)",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
